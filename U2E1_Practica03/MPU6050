#include <Wire.h>
#include "I2Cdev.h"
#include "MPU6050.h"

MPU6050 mpu;

int16_t ax, ay, az;

float Ax, Ay, Az;
float pitch, roll;

void setup() {

  Serial.begin(115200);
  Wire.begin();

  mpu.initialize();

  if(mpu.testConnection()){
    Serial.println("MPU6050 conectado correctamente");
  } else {
    Serial.println("Error al conectar MPU6050");
  }
}

void loop() {

  // Leer acelerómetro
  mpu.getAcceleration(&ax, &ay, &az);

  // Convertir a g
  Ax = ax / 16384.0;
  Ay = ay / 16384.0;
  Az = az / 16384.0;

  // Calcular pitch y roll
  pitch = atan(Ax / sqrt(Ay*Ay + Az*Az)) * 180 / PI;
  roll  = atan(Ay / sqrt(Ax*Ax + Az*Az)) * 180 / PI;

  //Serial.print("Pitch: ");
  Serial.print(pitch);
  Serial.print(",");
  //Serial.print("   Roll: ");
  Serial.println(roll);

  delay(100);
}

