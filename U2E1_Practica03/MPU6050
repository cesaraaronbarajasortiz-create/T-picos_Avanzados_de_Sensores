bool cara5() { return az > 15000; } //arriba
bool cara6() { return az < -15000; } //abajo

bool cara1() { return ax > 15000; } //atras
bool cara2() { return ax < -15000; } //adelante

bool cara3() { return ay > 15000 && abs(az) < 3000; } //izquierda
bool cara4() { return ay < -15000 && abs(ax) < 2000; } //derecha

void loop() {

  // BOTÓN
  if (digitalRead(BTN) == LOW) {
    iniciado = true;

    for (int i = 0; i < 6; i++) tiempos[i] = 0;

    tiempo_inicio = millis();
    cara_anterior = -1;
    cara_estable = 0;
    contador_estable = 0;
    en_pausa = false;

    delay(500);
  }

  if (!iniciado) return;

  // Leer MPU6050
  Wire.beginTransmission(MPU);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU, 6, true);

  if (Wire.available() == 6) {
    ax = Wire.read()<<8 | Wire.read();
    ay = Wire.read()<<8 | Wire.read();
    az = Wire.read()<<8 | Wire.read();
  } else {
    Serial.println("ERROR MPU");
    return;
  }

  // DETECCIÓN CALIBRADA
  int nueva_cara = 0;

  if (cara5()) nueva_cara = 5;
  else if (cara6()) nueva_cara = 6;
  else if (cara1()) nueva_cara = 1;
  else if (cara2()) nueva_cara = 2;
  else if (cara3()) nueva_cara = 3;
  else if (cara4()) nueva_cara = 4;
  else nueva_cara = 0;

  if (millis() - tiempo_serial > 800) {
  tiempo_serial = millis();

  Serial.print("AX: "); Serial.print(ax);
  Serial.print(" AY: "); Serial.print(ay);
  Serial.print(" AZ: "); Serial.print(az);
  Serial.print(" -> Cara: ");
  Serial.println(nueva_cara);
}

  // ESTABILIDAD
  if (nueva_cara == cara_actual) {
    contador_estable++;
  } else {
    contador_estable = 0;
    cara_actual = nueva_cara;
  }

  if (contador_estable >= umbral_contador) {
    cara_estable = nueva_cara;
  }

  // Cambio de cara
  if (cara_estable != 0 && cara_estable != cara_anterior) {

  // PRIMERA VEZ → NO PAUSA
  if (cara_anterior == -1) {
    tiempo_inicio = millis();   // iniciar conteo directo
    cara_anterior = cara_estable;
    return; // salir para no ejecutar pausa
  }

  // Guardar tiempo REAL de la cara anterior
  tiempo_congelado = millis() - tiempo_inicio;
  cara_mostrada = cara_anterior;

  // Activar pausa visual
  en_pausa = true;
  tiempo_pausa = millis();

  // Actualizar referencia
  cara_anterior = cara_estable;
}

  // OLED
  display.clearDisplay();
  display.setCursor(0,0);
  display.println("DADO DIGITAL");

  if (en_pausa) {

    display.setCursor(0,15);
    display.print("Cara: ");
    display.println(cara_mostrada);

    display.setCursor(0,30);
    display.print("Tarea: ");
    display.println(tareas[cara_mostrada - 1]);

    display.setCursor(0,50);
    display.print("Tiempo(s): ");

    //unsigned long tiempo_actual = tiempos[cara_mostrada - 1];

    //if (cara_mostrada == cara_anterior) {
    //  tiempo_actual += millis() - tiempo_inicio;
    //}

    display.print(tiempo_congelado / 1000);

    if (millis() - tiempo_pausa > pausa_visual) {
     en_pausa = false;

  // Reiniciar tiempo justo al terminar pausa
  tiempo_inicio = millis();
}
  }

  else if (cara_estable == 0) {

    display.setCursor(0,25);
    display.println("MOVIMIENTO...");
    display.setCursor(0,40);
    display.println("Mantener fijo");
  }

  else {

    display.setCursor(0,15);
    display.print("Cara: ");
    display.println(cara_estable);

    display.setCursor(0,30);
    display.print("Tarea: ");
    display.println(tareas[cara_estable - 1]);

    display.setCursor(0,50);
    display.print("Tiempo(s): ");

    unsigned long tiempo_actual = millis() - tiempo_inicio;
    int segundos = tiempo_actual / 1000;
    display.print(segundos);
  }

  display.display();
  delay(30);
}

