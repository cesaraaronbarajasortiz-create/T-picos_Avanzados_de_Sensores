#include <Wire.h>

#define SENSOR_ADDR 0x68
#define LED 13

int16_t rawX, rawY, rawZ;

float accelX, accelY, accelZ;
float totalAccel;

float umbralImpacto = 1.5;

void setup() {
  Serial.begin(115200);
  Wire.begin();

  pinMode(LED, OUTPUT);

  // Inicializar MPU6050
  Wire.beginTransmission(SENSOR_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();
}

void loop() {

  Wire.beginTransmission(SENSOR_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(SENSOR_ADDR, 6, true);

  rawX = Wire.read() << 8 | Wire.read();
  rawY = Wire.read() << 8 | Wire.read();
  rawZ = Wire.read() << 8 | Wire.read();

  accelX = rawX / 16384.0;
  accelY = rawY / 16384.0;
  accelZ = rawZ / 16384.0;

  totalAccel = sqrt(accelX*accelX + accelY*accelY + accelZ*accelZ);

  totalAccel = abs(totalAccel - 1.0);

  // Detectar impacto
  if (totalAccel > umbralImpacto) {
    digitalWrite(LED, HIGH); // activar airbag
    Serial.println("IMPACTO DETECTADO - AIRBAG ACTIVADO");
  } else {
    digitalWrite(LED, LOW);
  }

  delay(10);
}

