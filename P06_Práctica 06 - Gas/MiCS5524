--------------------------------------Alcoholímetro------------------------------------

#define PIN_SENSOR        A0
#define RL                10000.0
#define VC                5.0
#define MUESTRAS_CAL      200
#define A_ETANOL          1.53
#define B_ETANOL         -1.71
#define FACTOR_PARTICION  2100.0

float R0       = 0.0;
int   prueba   = 0;    // 0 = esperando, 1 = sin alcohol, 2 = con alcohol

// ── Calcula resistencia del sensor ──────────────────────────
float calcularRs(int raw) {
  float Vout = raw * (VC / 1023.0);
  if (Vout <= 0) return 999999.0;
  return RL * (VC - Vout) / Vout;
}

// ── Modelo curva datasheet: ppm = a * (Rs/R0)^b ─────────────
float calcularPPM(float ratio, float a, float b) {
  if (ratio <= 0) return 0;
  return a * pow(ratio, b);
}

// ── ppm etanol → BrAC (mg/L en aliento) ─────────────────────
float ppmToBrAC(float ppm) {
  return ppm / 1000.0;
}

// ── BrAC → BAC usando factor de partición 2100:1 ────────────
float brACToBAC(float brAC) {
  return (brAC * FACTOR_PARTICION) / 1000.0;
}

// ── Interpreta nivel de BAC ──────────────────────────────────
String interpretarBAC(float bac) {
  if (bac < 0.1) return "Sin alcohol detectable";
  if (bac < 0.3) return "Muy bajo";
  if (bac < 0.5) return "Bajo";
  if (bac < 0.8) return "Precaucion";
  if (bac < 1.5) return "SOBRE LIMITE LEGAL";
  return         "NIVEL PELIGROSO";
}

// ── Calibración en aire limpio ───────────────────────────────
void calibrar() {
  Serial.println("==============================================");
  Serial.println("  ALCOHOLIMETRO - MiCS5524");
  Serial.println("  Calibrando en aire limpio...");
  Serial.println("  Espere 3 minutos de calentamiento.");
  Serial.println("==============================================");
  delay(180000);

  float suma = 0;
  for (int i = 0; i < MUESTRAS_CAL; i++) {
    suma += calcularRs(analogRead(PIN_SENSOR));
    delay(50);
  }
  R0 = suma / MUESTRAS_CAL;

  Serial.print("  R0 = ");
  Serial.print(R0, 1);
  Serial.println(" ohms  -  Calibracion completada.");
  mostrarMenu();
}

// ── Menú de pruebas ──────────────────────────────────────────
void mostrarMenu() {
  Serial.println("==============================================");
  Serial.println("  Seleccione la prueba:");
  Serial.println("  1 -> Prueba SIN alcohol (exhalar normal)");
  Serial.println("  2 -> Prueba CON alcohol (algodon 70%)");
  Serial.println("  M -> Volver a este menu");
  Serial.println("==============================================");
}

// ── Procesa entrada del usuario ──────────────────────────────
void procesarSerial() {
  if (!Serial.available()) return;
  char tecla = Serial.read();

  if (tecla == '1') {
    prueba = 1;
    Serial.println(">> PRUEBA 1 - SIN ALCOHOL");
    Serial.println(">> Exhale normalmente en la carcasa.");
    Serial.println("Rs/R0   | ppm     | BrAC mg/L | BAC g/L | Estado");
    Serial.println("--------------------------------------------------");
  }
  else if (tecla == '2') {
    prueba = 2;
    Serial.println(">> PRUEBA 2 - CON ALCOHOL (algodon 70%)");
    Serial.println(">> Introduzca el algodon en la entrada de la carcasa.");
    Serial.println("Rs/R0   | ppm     | BrAC mg/L | BAC g/L | Estado");
    Serial.println("--------------------------------------------------");
  }
  else if (tecla == 'M' || tecla == 'm') {
    prueba = 0;
    mostrarMenu();
  }
}

void setup() {
  Serial.begin(9600);
  calibrar();
}

void loop() {
  procesarSerial();

  // Solo mide cuando hay una prueba activa
  if (prueba == 0) {
    delay(500);
    return;
  }

  int   raw   = analogRead(PIN_SENSOR);
  float Rs    = calcularRs(raw);
  float ratio = Rs / R0;
  float ppm   = calcularPPM(ratio, A_ETANOL, B_ETANOL);
  float brAC  = ppmToBrAC(ppm);
  float bac   = brACToBAC(brAC);

  // Etiqueta de prueba
  String etiqueta = (prueba == 1) ? "[SIN-ALCOHOL] " : "[CON-ALCOHOL] ";

  Serial.print(etiqueta);
  Serial.print(ratio, 3);  Serial.print("  |  ");
  Serial.print(ppm,   2);  Serial.print(" ppm  |  ");
  Serial.print(brAC,  4);  Serial.print(" mg/L  |  ");
  Serial.print(bac,   4);  Serial.print(" g/L  |  ");
  Serial.println(interpretarBAC(bac));

  delay(1000);
}

