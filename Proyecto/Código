#include <Wire.h>
#include <Adafruit_VL53L0X.h>
#include <SoftwareSerial.h>
#include <math.h>

// ================= HC-05 =================
SoftwareSerial BT(10, 11);

// ================= SENSOR DISTANCIA =================
Adafruit_VL53L0X lox;
const byte IMU_ADDR = 0x68;

// ================= PINES =================
const byte BUZZER = 8;
const byte LED_ROJO = 9;
const byte LED_VERDE = 6;
const byte BOTON_CANCELA = 7;

// ================= ESTADOS =================
#define NORMAL 0
#define OBST_1 1
#define OBST_2 2
#define OBST_3 3
#define OBST_4 4
#define ALERTA_CAIDA 5
#define ALERTA_CONFIRMADA 6

byte estadoSistema = NORMAL;
byte estadoDistancia = NORMAL;

// ================= TIMERS =================
unsigned long tBuzzer = 0;
unsigned long tCaida = 0;
unsigned long tPostura = 0;

// ================= UMBRALES =================
const float UMBRAL_CAIDA_LIBRE = 0.40;
const float UMBRAL_IMPACTO = 1.50;
const float UMBRAL_IMPACTO_DIRECTO = 2.30;
const float UMBRAL_JERK = 1.35;

const float UMBRAL_HORIZONTAL = 25.0;
const unsigned long TIEMPO_POSTURA = 900;
const unsigned long TIEMPO_ALERTA = 10000; // 10 s

// ================= VARIABLES =================
bool posibleCaidaLibre = false;
unsigned long tCaidaLibre = 0;
float A_anterior = 1.0;

bool caidaEnviada = false;
bool ubicacionEnviada = false;

// =======================================================
// ===================== IMU =============================
// =======================================================
void despertarIMU() {
  Wire.beginTransmission(IMU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();
}

bool leerIMU(float &ax, float &ay, float &az) {
  Wire.beginTransmission(IMU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;

  Wire.requestFrom(IMU_ADDR, (byte)6);
  if (Wire.available() < 6) return false;

  int16_t axR = (Wire.read() << 8) | Wire.read();
  int16_t ayR = (Wire.read() << 8) | Wire.read();
  int16_t azR = (Wire.read() << 8) | Wire.read();

  ax = axR / 16384.0;
  ay = ayR / 16384.0;
  az = azR / 16384.0;

  return true;
}

// =======================================================
// ================= ACTIVAR CAÍDA =======================
// =======================================================
void activarCaida() {

  if (estadoSistema == NORMAL) {

    estadoSistema = ALERTA_CAIDA;
    tCaida = millis();

    caidaEnviada = false;
    ubicacionEnviada = false;

    BT.println("CAIDA DETECTADA");
    Serial.println("CAIDA DETECTADA");

    tone(BUZZER, 1800);
  }
}

// =======================================================
// ================= SETUP ===============================
// =======================================================
void setup() {

  Serial.begin(9600);
  Wire.begin();

  pinMode(BUZZER, OUTPUT);
  pinMode(LED_ROJO, OUTPUT);
  pinMode(LED_VERDE, OUTPUT);
  pinMode(BOTON_CANCELA, INPUT_PULLUP);

  BT.begin(9600);

  digitalWrite(LED_VERDE, HIGH);

  BT.println("Baston listo");

  if (!lox.begin()) {
    Serial.println("Error VL53L0X");
    while (1);
  }

  despertarIMU();
  delay(100);
}

// =======================================================
// ================= LOOP ================================
// =======================================================
void loop() {

  leerObstaculo();
  detectarCaida();
  manejarSistema();
  manejarBoton();
}

// =======================================================
// ================= DISTANCIA ===========================
// =======================================================
void leerObstaculo() {

  VL53L0X_RangingMeasurementData_t m;
  lox.rangingTest(&m, false);

  if (m.RangeStatus == 4) {
    estadoDistancia = NORMAL;
    return;
  }

  int d = m.RangeMilliMeter;

  if (d > 1000) estadoDistancia = NORMAL;
  else if (d > 500) estadoDistancia = OBST_1;
  else if (d > 300) estadoDistancia = OBST_2;
  else if (d > 200) estadoDistancia = OBST_3;
  else estadoDistancia = OBST_4;
}

// =======================================================
// ================= CAÍDA ===============================
// =======================================================
void detectarCaida() {

  if (estadoSistema != NORMAL) return;

  float ax, ay, az;
  if (!leerIMU(ax, ay, az)) return;

  float A = sqrt(ax * ax + ay * ay + az * az);
  float Y = atan2(-ax, sqrt(ay * ay + az * az)) * 180.0 / PI;
  float jerk = abs(A - A_anterior);
  A_anterior = A;

  unsigned long ahora = millis();

  if (A < UMBRAL_CAIDA_LIBRE) {
    posibleCaidaLibre = true;
    tCaidaLibre = ahora;
  }

  if (posibleCaidaLibre && ahora - tCaidaLibre > 1500) {
    posibleCaidaLibre = false;
  }

  if (posibleCaidaLibre && A > UMBRAL_IMPACTO) {
    activarCaida();
  }

  if (A > UMBRAL_IMPACTO_DIRECTO || jerk > UMBRAL_JERK) {
    activarCaida();
  }

  bool horizontal = abs(Y) < UMBRAL_HORIZONTAL;

  if (horizontal) {

    if (tPostura == 0) tPostura = ahora;

    if (ahora - tPostura > TIEMPO_POSTURA) {
      activarCaida();
    }

  } else {
    tPostura = 0;
  }
}

// =======================================================
// ================= SISTEMA =============================
// =======================================================
void manejarSistema() {

  unsigned long ahora = millis();

  // ================= CAÍDA ACTIVA =================
  if (estadoSistema == ALERTA_CAIDA) {

    tone(BUZZER, 1800);
    digitalWrite(LED_ROJO, HIGH);

    if (ahora - tCaida >= TIEMPO_ALERTA && !caidaEnviada) {

      estadoSistema = ALERTA_CONFIRMADA;
      caidaEnviada = true;

      BT.println("CAIDA CONFIRMADA");
      Serial.println("CAIDA CONFIRMADA");

      noTone(BUZZER);
    }
  }

  // ================= CONFIRMADA =================
  else if (estadoSistema == ALERTA_CONFIRMADA) {

    digitalWrite(LED_ROJO, HIGH);

    if (!ubicacionEnviada) {

      BT.println("UBICACION: 24.50, -102.18");
      Serial.println("UBICACION ENVIADA");

      ubicacionEnviada = true;
    }

    if (millis() % 2000 < 100) {
      tone(BUZZER, 1200, 100);
    }
  }

  // ================= NORMAL =================
  else {

    digitalWrite(LED_ROJO, LOW);

    int freq = 0;
    int intervalo = 0;

    switch (estadoDistancia) {

      case NORMAL:
        noTone(BUZZER);
        return;

      case OBST_1:
        freq = 900; intervalo = 500; break;

      case OBST_2:
        freq = 1100; intervalo = 300; break;

      case OBST_3:
        freq = 1400; intervalo = 150; break;

      case OBST_4:
        freq = 1800; intervalo = 80; break;
    }

    if (millis() - tBuzzer >= intervalo) {
      tone(BUZZER, freq, 60);
      tBuzzer = millis();
    }
  }
}

// =======================================================
// ================= BOTÓN ===============================
// =======================================================
void manejarBoton() {

  if (digitalRead(BOTON_CANCELA) == LOW) {

    if (estadoSistema == ALERTA_CAIDA || estadoSistema == ALERTA_CONFIRMADA) {

      estadoSistema = NORMAL;

      BT.println("ALERTA CANCELADA");

      Serial.println("ALERTA CANCELADA");

      noTone(BUZZER);
      digitalWrite(LED_ROJO, LOW);

      delay(300);
    }
  }
}
