----------------------------Gráfica psicrométrica (MATLAB)-------------------------------

clc;
clear;
close all;

%% Leer datos
datos = readmatrix('datos.xlsx');

T = datos(:,1);
HR = datos(:,2);

%% Separar calentamiento y enfriamiento
idx = 20;

T_enf = T(1:idx);
HR_enf = HR(1:idx);

T_cal = T(idx+1:end);
HR_cal = HR(idx+1:end);

%% Datos importantes
HR_max = max(HR);
HR_min = min(HR);

T_HRmax = T(HR == HR_max);
T_HRmin = T(HR == HR_min);

Tmin = min(T);
Tmax = max(T);

HR_range = HR_max - HR_min;

%% Figura general
figure('Color','white','Position',[100 100 1200 700]);

tiledlayout(2,4,'Padding','compact','TileSpacing','compact');

%% ======================================
%% GRAFICA PRINCIPAL (TEMA CLARO)
%% ======================================
nexttile([1 4]);

hold on;
grid on;
box on;

plot(T_cal, HR_cal,'-o', ...
    'Color',[0.85 0.33 0.1], ...
    'LineWidth',2,...
    'MarkerFaceColor',[0.85 0.33 0.1]);

plot(T_enf, HR_enf,'-o', ...
    'Color',[0 0.45 0.74], ...
    'LineWidth',2,...
    'MarkerFaceColor',[0 0.45 0.74]);

xlabel('Temperatura promedio (°C)','FontSize',12);
ylabel('Humedad relativa (%)','FontSize',12);

title('Curva psicrométrica experimental','FontSize',14);

legend('Calentamiento','Enfriamiento',...
    'Location','northwest');

xlim([21 28]);
ylim([35 85]);

%% ======================================
%% TARJETA 1
%% ======================================
nexttile;

axis off;
set(gca,'Color','#1E1E1E');

rectangle('Position',[0 0 1 1],...
          'FaceColor',[0.12 0.12 0.12],...
