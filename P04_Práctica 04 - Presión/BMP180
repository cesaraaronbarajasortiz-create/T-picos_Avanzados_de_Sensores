#include <Wire.h>
#include <Adafruit_BMP085.h>

Adafruit_BMP085 bmp;

// Presión meteorológica actual de Zacatecas
const float PRESION_NIVEL_MAR = 102300; // Pa

void setup() {

  Serial.begin(9600);

  if (!bmp.begin()) {
    Serial.println("No se detecta BMP180");
    while (1);
  }

  Serial.println("BMP180 iniciado correctamente");
}

void loop() {

  // Lectura de presión absoluta
  float presion = bmp.readPressure();

  // Cálculo de altitud usando presión meteorológica real
  float altitud = bmp.readAltitude(PRESION_NIVEL_MAR);

  // Temperatura
  float temperatura = bmp.readTemperature();

  Serial.print("Temperatura: ");
  Serial.print(temperatura);
  Serial.println(" °C");

  Serial.print("Presion absoluta: ");
  Serial.print(presion);
  Serial.println(" Pa");

  Serial.print("Altitud calculada: ");
  Serial.print(altitud);
  Serial.println(" m");

  Serial.println("------------------------");

  delay(2000);
}

