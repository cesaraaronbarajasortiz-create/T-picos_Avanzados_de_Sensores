            Tmax = max(temperaturas);
            Tmin = min(temperaturas);

            UC = ((Tmax + Tmin)/2) - Tbase;

            if UC < 0
                UC = 0;
            end

            UC_acumuladas = UC_acumuladas + UC;

            % Determinar etapa
            if UC_acumuladas < 100
                etapa = "Germinación";
            elseif UC_acumuladas < 400
                etapa = "Crecimiento";
            elseif UC_acumuladas < 700
                etapa = "Floración";
            else
                etapa = "Maduración";
