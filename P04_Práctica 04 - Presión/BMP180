#include <Wire.h>
#include <Adafruit_BMP085.h>

Adafruit_BMP085 bmp;

// Pin LM35
int pinLM35 = A0;

// Tiempo
unsigned long tiempoInicio;

// Número de muestras para promedio (reduce ruido)
const int N = 10;

void setup() {
  Serial.begin(9600);

  //analogReference(INTERNAL);

  bmp.begin();

  tiempoInicio = millis();

  // Encabezado limpio para MATLAB
  Serial.println("Tiempo,LM35,BMP180");
}

void loop() {

  // Tiempo en segundos
  float tiempo = (millis() - tiempoInicio) / 1000.0;

  // Promedio LM35 (anti-ruido)
  float suma = 0;
  for (int i = 0; i < N; i++) {
    suma += analogRead(pinLM35);
    delay(10); // pequeña pausa
  }
  float lecturaProm = suma / N;

  float voltaje = lecturaProm * (5.0 / 1023.0);
  float tempLM35 = voltaje * 100.0;

  // BMP180
  float tempBMP = bmp.readTemperature();

  // Filtro de valores erróneos
  if (tempLM35 > 0 && tempLM35 < 100) {

    Serial.print(tiempo);
    Serial.print(",");
    Serial.print(tempLM35);
    Serial.print(",");
    Serial.println(tempBMP);
  }

  // Tiempo de muestreo (cada 5 s)
  delay(5000);
}

