-----------------------------formula del CIPM-2007--------------------------

clc; clear; close all;

%% === DATOS DE ENTRADA ===

T_C = 28.90;            % Temperatura en °C
p = 77656;           % Presión en Pa
HR = 0.2113;           % Humedad relativa (0 a 1)

%% === CONVERSIONES ===
T = T_C + 273.15;    % Temperatura en Kelvin

%% === CONSTANTES ===
R = 8.314472;        % J/(mol·K)
Ma = 0.02896546;     % kg/mol (aire seco)
Mv = 0.01801528;     % kg/mol (vapor de agua)

%% === PRESIÓN DE VAPOR SATURADO (Pa) ===
% Fórmula tipo Magnus (suficientemente precisa para práctica)
psv = 610.94 * exp((17.625 * T_C) / (T_C + 243.04));

%% === FRACCIÓN MOLAR DE VAPOR DE AGUA ===
xv = (HR * psv) / p;

%% === FACTOR DE COMPRESIBILIDAD (aprox. ideal) ===
Z = 1;   % Para condiciones normales (puedes refinar si lo necesitas)

%% === DENSIDAD DEL AIRE (CIPM-2007) ===
rho = (p * Ma) / (Z * R * T) * (1 - xv * (1 - (Mv / Ma)));

%% === RESULTADO ===
fprintf('Densidad del aire: %.4f kg/m^3\n', rho);

